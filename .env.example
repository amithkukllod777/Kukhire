# ---- KukHire API (all variables are prefixed KUKHIRE_) --------------------------------
# Database. PostgreSQL in production; SQLite is a local-development convenience only.
# KUKHIRE_DATABASE_URL wins over DATABASE_URL.
# KUKHIRE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kukhire
KUKHIRE_ENVIRONMENT=development

# Identity: base URL of the Kuklabs Account (AuthKit REST) host. No default on purpose;
# unset means every authenticated route answers 503. Verified via GET {url}/v1/auth/me.
KUKHIRE_AUTH_BASE_URL=
KUKHIRE_AUTH_PRODUCT_ID=kukhire

# Hosts KukHire may send a hire handoff to (comma separated host[:port]). Empty = none allowed.
KUKHIRE_HRMS_ALLOWED_HOSTS_CSV=
# Local development only: permit plain http handoff targets.
KUKHIRE_HRMS_ALLOW_INSECURE_HTTP=false

# Fernet key for secrets at rest (workspace HRMS API keys). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KUKHIRE_SECRET_ENCRYPTION_KEY=

# Advisory AI evaluation. OFF by default; local Ollama only (no paid provider is wired).
KUKHIRE_EVALUATION_ENABLED=false
KUKHIRE_EVALUATION_PROVIDER=ollama
KUKHIRE_EVALUATION_MODEL=gemma3:4b

# Origins allowed to call the API from a browser on another host (comma separated).
KUKHIRE_CORS_ALLOWED_ORIGINS_CSV=
KUKHIRE_SERVE_UI=true

# ---- Command-line resume scorer (score.py) --------------------------------------------
LLM_PROVIDER=ollama
DEFAULT_MODEL=gemma3:4b
# Only needed if LLM_PROVIDER=gemini (a paid provider: do not enable without owner approval).
GEMINI_API_KEY=
# Writes cached GitHub responses (personal data) to ./cache. Off unless set to 1.
KUKHIRE_CLI_DEV_MODE=
